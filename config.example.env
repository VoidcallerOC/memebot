# ---------------------------------------------------------------------------
# Solana Memecoin Trading Bot — configuration
# Copy to `.env` and edit. NEVER commit your real .env or private key.
# ---------------------------------------------------------------------------

# === SAFETY LOCK ============================================================
# Master switch. While false, the bot NEVER spends real money — it only logs
# the trades it would have made. Set to true ONLY when you are ready to risk
# real funds and have read the README.
LIVE_TRADING=false

# === WALLET / RPC ===========================================================
# Base58-encoded Solana private key. Required only for live trading.
# Treat this like the password to your money. Use a dedicated burner wallet
# funded with ONLY what you can afford to lose.
WALLET_PRIVATE_KEY=
# Public address of the dedicated burner wallet. Safe to compare/log; never
# place the corresponding private key in source code or chat.
BURNER_WALLET_PUBKEY=

# Solana RPC endpoint. A private/paid RPC (Helius, Triton, QuickNode) is
# strongly recommended for live trading; the public one is rate-limited.
RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter swap API base URL. The legacy quote-api.jup.ag/v6 host was deprecated
# on 2025-10-01. The default below is the keyless free tier and needs no key.
# With a Jupiter API key, set JUPITER_API_KEY and switch this to
# https://api.jup.ag/swap/v1 for higher rate limits.
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# === BANKROLL & POSITION SIZING =============================================
# Total capital (USD) the bot is allowed to manage.
BANKROLL_USD=100

# Max percent of bankroll to put into a single position.
MAX_POSITION_PCT=2

# Max number of positions open at once.
MAX_OPEN_POSITIONS=3

# === RISK CONTROLS ==========================================================
# Hard stop-loss per position, in percent below entry.
STOP_LOSS_PCT=15

# Stop trading for the rest of the day after total drawdown exceeds this
# percent of starting bankroll. This is the circuit breaker.
DAILY_LOSS_LIMIT_PCT=10

# Take-profit ladder: comma-separated `gainPct:sellFraction` pairs.
# `50:0.5` => when up 50%, sell 50% of the position. Fractions are of the
# ORIGINAL position size and should sum to <= 1.0.
TAKE_PROFIT_LADDER=50:0.5,100:0.25,300:0.25

# Max acceptable slippage on a swap, in basis points (100 = 1%).
MAX_SLIPPAGE_BPS=150

# === TOKEN SAFETY SCREEN ====================================================
# Minimum on-chain liquidity (USD) required to consider a token.
MIN_LIQUIDITY_USD=20000

# Require that liquidity is locked/burned.
REQUIRE_LIQUIDITY_LOCKED=true

# Require that the mint authority is revoked (can't print more supply).
REQUIRE_MINT_REVOKED=true

# Require that the freeze authority is revoked (can't freeze your tokens =
# can't be a honeypot via freeze).
REQUIRE_FREEZE_REVOKED=true

# Reject tokens where the top holder controls more than this percent.
MAX_TOP_HOLDER_PCT=25

# === LOOP ===================================================================
# Seconds between strategy evaluations.
POLL_INTERVAL_SECONDS=15

# === STRATEGY (candidate source) ===========================================
# Which entry source feeds the safety screen. Candidates are NEVER bought
# blind — every one still passes safety.py + risk.py.
#   boosted      -> DexScreener boosted/active tokens (default; broad, noisy)
#   smart_money  -> tokens a watchlist of wallets is newly accumulating (RPC)
STRATEGY=boosted

# Wallets to follow when STRATEGY=smart_money. Comma- or space-separated
# addresses, and/or a file (one address per line, # comments allowed).
# Read via your RPC_URL, so a private/paid RPC is recommended here too.
SMART_MONEY_WALLETS=
SMART_MONEY_WALLETS_FILE=

# By default a watched wallet's pre-existing bag is treated as baseline (only
# NEW accumulation is surfaced). Set true to also surface what they already
# hold on first sight. Usually leave false.
SMART_MONEY_SURFACE_EXISTING=false

# === ALERTS (optional; off unless filled in) ================================
# Telegram: create a bot via @BotFather, get the token, then message your bot
# and find your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: a channel webhook URL (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=

# === PERSISTENCE ============================================================
# Where open positions + daily PnL are saved so the bot survives a restart.
STATE_FILE=state.json
